<?xml version='1.0' encoding='UTF-8'?>
<!-- The main window. Everything the user sees sits inside one vertical
     layout: a header bar on top, the stacked pages in the middle, and a
     thin status line at the bottom. -->
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1100</width>
    <height>760</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>920</width>
    <height>640</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>BudgetBites</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">
    <property name="spacing">
     <number>0</number>
    </property>
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
    <item>
     <!-- Top header bar: app name on the left, a spacer to push everything
          else to the right, then the small photo, then the signed in
          status pill. -->
     <layout class="QHBoxLayout" name="headerLayout">
      <property name="leftMargin">
       <number>28</number>
      </property>
      <property name="topMargin">
       <number>18</number>
      </property>
      <property name="rightMargin">
       <number>28</number>
      </property>
      <property name="bottomMargin">
       <number>18</number>
      </property>
      <item>
       <widget class="QLabel" name="brandLabel">
        <property name="styleSheet">
         <string notr="true">QLabel {
    background-color: transparent;
    color: #F4F4F4;
    font-size: 18px;
    font-weight: 700;
    padding: 4px;
}</string>
        </property>
        <property name="text">
         <string>🍽 BudgetBites</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="headerSpacer">
        <property name="orientation">
         <enum>Qt::Orientation::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>40</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <!-- Small round preview of the signed in user's profile photo.
            Filled in and swapped for the placeholder by
            refreshProfileImagePreview in MainWindow.cpp. -->
       <widget class="QLabel" name="headerAvatarLabel">
        <property name="minimumSize">
         <size>
          <width>32</width>
          <height>32</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>32</width>
          <height>32</height>
         </size>
        </property>
        <property name="styleSheet">
         <string notr="true">QLabel {
    background-color: #2B2E30;
    border: 1px solid #3A3E40;
    border-radius: 16px;
}</string>
        </property>
        <property name="alignment">
         <set>Qt::AlignmentFlag::AlignCenter</set>
        </property>
        <property name="scaledContents">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item>
       <!-- Text pill that reads "Not signed in" or "Signed in as ...".
            Updated by updateSignedInState in MainWindow.cpp. -->
       <widget class="QLabel" name="signedInLabel">
        <property name="styleSheet">
         <string notr="true">QLabel {
    background-color: #2B2E30;
    color: #AEB4B7;
    border: 1px solid #3A3E40;
    border-radius: 12px;
    padding: 7px 12px;
}</string>
        </property>
        <property name="text">
         <string>Not signed in</string>
        </property>
       </widget>
      </item>
     </layout>
    </item>
    <item>
     <!-- Holds every page (dashboard, account, preferences, and so on).
          MainWindow.cpp adds each page widget to this in its constructor
          and flips currentIndex to switch screens. -->
     <widget class="QStackedWidget" name="pages">
      <property name="styleSheet">
       <string notr="true">QFrame {
    background-color: #232526;
    border: 1px solid #34383A;
    border-radius: 14px;
}</string>
      </property>
      <property name="currentIndex">
       <number>0</number>
      </property>
     </widget>
    </item>
    <item>
     <!-- Thin status line along the bottom of the window. Set by
          setGlobalStatus in MainWindow.cpp, and turns red for errors. -->
     <widget class="QLabel" name="globalStatusLabel">
      <property name="text">
       <string />
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
      <property name="margin">
       <number>10</number>
      </property>
     </widget>
    </item>
